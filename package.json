    "@types/pngjs": "^6.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "pixelmatch": "^8.0.0",
